---
/**
 * Login Page
 * 
 * @description
 * User login page with authentication via backend API
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { LoginView } from '@/components/auth/LoginView';
---

<BaseLayout
  title="Iniciar Sesión"
  description="Inicia sesión en tu cuenta de GoFlowTrips"
>
  <div class="auth-page">
    <div class="auth-container">
      <div class="auth-card">
        <div class="auth-header">
          <a href="/" class="logo-link">
            <h1 class="logo">GoFlow<span class="logo-accent">Trips</span></h1>
          </a>
          <p class="auth-subtitle">Inicia sesión en tu cuenta</p>
        </div>
        <LoginView client:only="react" />
       
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .auth-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    background: linear-gradient(135deg, var(--color-background) 0%, var(--color-surface) 100%);
  }

  .auth-container {
    width: 100%;
    max-width: 28rem;
  }

  .auth-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl, 1rem);
    padding: 2.5rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  }

  .auth-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .logo-link {
    text-decoration: none;
  }

  .logo {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.5rem 0;
  }

  .logo-accent {
    color: var(--color-primary);
  }

  .auth-subtitle {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .auth-footer-text {
    text-align: center;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-top:1.5rem;
  }

  .auth-link {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
  }

  .auth-link:hover {
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .auth-card {
      padding: 1.5rem;
    }

    .logo {
      font-size: 1.75rem;
    }
  }
</style>
