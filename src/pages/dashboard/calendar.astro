---
/**
 * Calendar Page - Interactive travel calendar
 *
 * @description
 * Dedicated page for viewing and managing travel events in an interactive calendar.
 * Shows all travel-related activities, bookings, and important dates.
 */
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import { CalendarDashboardView } from '@/components/dashboard-ui/CalendarDashboardView';
---

<DashboardLayout
  title="Calendario"
  description="Planifica tus actividades de viaje"
  breadcrumbs={[
    { label: 'Panel', href: '/dashboard' },
    { label: 'Calendario' }
  ]}
>
  <CalendarDashboardView client:only="react" />
</DashboardLayout>

<style>
  .calendar-page {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Page Header */
  .page-header {
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text);
    margin: 0 0 0.5rem 0;
    line-height: 1.2;
  }

  .page-description {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Legend */
  .calendar-legend {
    padding: 1.5rem;
    background: var(--color-surface, #fff);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg, 1rem);
  }

  .legend-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 1rem 0;
  }

  .legend-items {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1rem;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .legend-dot {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .legend-dot-flight {
    background: var(--color-primary, #6366f1);
  }

  .legend-dot-hotel {
    background: var(--color-success, #10b981);
  }

  .legend-dot-activity {
    background: var(--color-warning, #f59e0b);
  }

  .legend-dot-other {
    background: var(--color-text-muted, #6b7280);
  }

  .legend-label {
    font-size: 0.875rem;
    color: var(--color-text);
  }

  /* Responsive */
  @media (max-width: 640px) {
    .page-title {
      font-size: 1.75rem;
    }

    .legend-items {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
