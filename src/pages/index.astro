---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Hero from '@sections/marketing/Hero.astro';
import HowItWorks from '@sections/marketing/HowItWorks.astro';
import BentoGrid from '@sections/marketing/BentoGrid.astro';
import CTA from '@sections/marketing/CTA.astro';
import Newsletter from '@sections/marketing/Newsletter.astro';
import { siteConfig } from '@/config';
import DestinationsCarousel from '@/components/DestinationsCarousel.astro';
import BookingModal from '@/components/BookingModal.astro';


// Fetch destinations from backend API
let destinations = [];
try {
  const response = await fetch('http://localhost:8000/api/destinos/');
  if (response.ok) {
    destinations = await response.json();
  }
} catch (error) {
  console.error('Error fetching destinations:', error);
  // Fallback 
  destinations = [
    {
      id: 1,
      titulo: "París, Francia",
      descripcion: "Descubre la ciudad del amor con la Torre Eiffel, el Louvre y encantadoras calles bohemias.",
      precio: 1299.99,
      imagen_url: "https://images.unsplash.com/photo-1502602898657-3e91760cbb34?w=400",
      disponible: true
    },
    {
      id: 2,
      titulo: "Tokyo, Japón",
      descripcion: "Experimenta la perfecta mezcla de tradición milenaria y tecnología futurista.",
      precio: 1899.99,
      imagen_url: "https://images.unsplash.com/photo-1493976040374-85c8e12f0c0e?w=400",
      disponible: true
    },
    {
      id: 3,
      titulo: "Nueva York, USA",
      descripcion: "La ciudad que nunca duerme te espera con sus rascacielos icónicos y energía inagotable.",
      precio: 1599.99,
      imagen_url: "https://images.unsplash.com/photo-1496442226666-8d4d0e62e6e9?w=400",
      disponible: true
    }
  ];
}

const bentoItems = [
  {
    title: 'Agenda de horarios',
    description:
      'Mantén todos tus vuelos, hoteles y actividades organizados en un solo lugar.',
    icon: 'lucide:clock',
    size: 'large' as const,
    accent: 'primary' as const,
    href: '#viajes',
  },
  {
    title: 'Reserva de hoteles',
    description: 'Reserva en los mejores hoteles con descuentos exclusivos.',
    icon: 'lucide:hotel',
    accent: 'blue' as const,
    href: '#viajes',
  },
  {
    title: 'Paquetes Todo Incluido',
    description: 'Disfruta sin preocupaciones con nuestros paquetes completos.',
    icon: 'lucide:package',
    accent: 'green' as const,
    href: '#viajes',
  },
  {
    title: 'Asistencia 24/7',
    description:
      'Soporte continuo durante todo tu viaje. Estamos contigo en cada paso.',
    icon: 'lucide:phone',
    size: 'medium' as const,
    accent: 'purple' as const,
    href: '#contacto',
  },
];

---

<MarketingLayout
  title={`${siteConfig.name} - ${siteConfig.description}`}
  description={siteConfig.description}
>
  <Hero
    backgroundVideo='/ViajesVideo.mp4'
    backgroundType='video'
    overlay={true}
    overlayOpacity={30}
    destinations={destinations}
  />

  <DestinationsCarousel destinations={destinations} />
  <BookingModal />

  <HowItWorks
    title="Reserva tu viaje en 3 simples pasos"
    subtitle="Desde la búsqueda hasta tu destino en minutos, no horas."
    steps={[
      {
        title: 'Busca tu destino',
        description:
          "Explora cientos de destinos con filtros personalizados. Encuentra el lugar perfecto para tu próxima aventura.",
        icon: 'lucide:search',
      },
      {
        title: 'Agenda tu viaje',
        description:
          'Completa el formulario con tus datos y confirma tu reserva en segundos.',
        icon: 'lucide:calendar-check',
      },
      {
        title: 'Disfruta tu viaje',
        description: 'Prepárate para vivir una experiencia inolvidable en tu destino elegido.',
        icon: 'lucide:plane-takeoff',
      },
    ]}
    variant="horizontal"
    background="muted"
  />

  <BentoGrid
    title="Características de GoFlowTrips"
    subtitle="Diseñadas por viajeros, para viajeros. Cada función pensada para hacer tu experiencia más fácil y emocionante."
    items={bentoItems}
    background="muted"
  />

 

  <CTA
    title="¿Listo para tu próxima aventura?"
    description="Comienza con GoFlowTrips hoy. No se requiere tarjeta de crédito para el plan gratuito."
    action={{ label: 'Comenzar a Explorar', href: '#viajes' }}
  />

  <Newsletter />
</MarketingLayout>
