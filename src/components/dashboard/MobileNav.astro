---
/**
 * MobileNav - Componente de navegación para móviles (Drawer)
 */

import { Icon } from 'astro-icon/components';
import { dashboardNavigation } from '../../config/dashboard-navigation';

// Obtener ruta actual
const currentPath = Astro.url.pathname;

/**
 * Función auxiliar para verificar si un ítem está activo
 */
function isActive(href: string, children?: any[]): boolean {
  if (currentPath === href) return true;
  if (children) {
    return children.some((child) => currentPath === child.href);
  }
  return false;
}
---

<!-- Backdrop Overlay -->
<div 
  id="mobile-nav-backdrop" 
  class="fixed inset-0 bg-gray-900/50 z-40 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden backdrop-blur-sm"
  aria-hidden="true"
></div>

<!-- Mobile Navigation Drawer -->
<aside
  id="mobile-nav"
  class="fixed top-0 left-0 h-full w-72 max-w-[85vw] bg-zinc-50 dark:bg-zinc-950 border-r border-zinc-200 dark:border-zinc-800 z-50 -translate-x-full transition-transform duration-300 ease-in-out md:hidden flex flex-col shadow-2xl"
  aria-label="Navegación móvil"
  role="dialog"
  aria-modal="true"
>
  <!-- Header with Close Button -->
  <div class="h-16 px-4 flex items-center justify-between border-b border-gray-200 dark:border-gray-800 shrink-0">
    <a href="/dashboard" class="flex items-center gap-3 text-zinc-900 dark:text-white font-semibold text-lg">
      <Icon name="lucide:layout-dashboard" class="w-6 h-6 text-zinc-900 dark:text-white" />
      <span>GoFlowTrips</span>
    </a>
    <button 
      id="mobile-nav-close" 
      class="p-2 rounded-lg text-zinc-500 hover:bg-zinc-100 dark:hover:bg-zinc-800 hover:text-zinc-900 dark:hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-zinc-400"
      aria-label="Cerrar navegación"
    >
      <Icon name="lucide:x" class="w-6 h-6" />
    </button>
  </div>

  <!-- Navigation Content -->
  <nav class="flex-1 overflow-y-auto overflow-x-hidden py-4 px-3 space-y-6 custom-scrollbar">
    {
      dashboardNavigation.map((section) => (
        <div class="flex flex-col gap-1">
          {/* Título de Sección */}
          {section.title && (
            <div class="px-2 mb-2">
              <span class="text-xs font-semibold text-gray-400 dark:text-gray-500 uppercase tracking-wider">
                {section.title}
              </span>
            </div>
          )}

          {/* Items */}
          <ul class="space-y-1" role="list">
            {section.items.map((item) => {
              const itemActive = isActive(item.href, item.children);

              return (
                <li>
                  {/* Parent Item */}
                  <a
                    href={item.href}
                    class:list={[
                      'group flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium transition-all duration-200',
                      itemActive 
                        ? 'bg-zinc-200/50 dark:bg-zinc-800 text-zinc-900 dark:text-white shadow-none' 
                        : 'text-zinc-600 dark:text-zinc-300 hover:bg-zinc-200/30 dark:hover:bg-zinc-900/50 hover:text-zinc-900 dark:hover:text-white'
                    ]}
                    aria-current={currentPath === item.href ? 'page' : undefined}
                    data-mobile-nav-link
                  >
                    <Icon name={`lucide:${item.icon}`} class="w-5 h-5 shrink-0" />
                    <span class="flex-1">{item.label}</span>
                    {item.children && (
                      <Icon
                        name="lucide:chevron-down"
                        class:list={[
                          'w-4 h-4 shrink-0 transition-transform duration-200',
                          { 'rotate-180': itemActive }
                        ]}
                      />
                    )}
                  </a>

                  {/* Nested Children */}
                  {item.children && (
                    <ul
                      class:list={[
                        'mt-1 space-y-1 overflow-hidden transition-all duration-300',
                        itemActive ? 'max-h-96 opacity-100' : 'max-h-0 opacity-0'
                      ]}
                      role="list"
                    >
                      {item.children.map((child) => (
                        <li>
                          <a
                            href={child.href}
                            class:list={[
                              'flex items-center gap-3 pl-11 pr-3 py-2.5 rounded-lg text-sm transition-colors',
                              currentPath === child.href
                                ? 'text-zinc-900 dark:text-white bg-zinc-200/50 dark:bg-zinc-800 font-medium'
                                : 'text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-200/30 dark:hover:bg-zinc-800'
                            ]}
                            aria-current={currentPath === child.href ? 'page' : undefined}
                            data-mobile-nav-link
                          >
                            <Icon name={`lucide:${child.icon}`} class="w-4 h-4" />
                            <span>{child.label}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }

    <!-- Admin Navigation (Mobile) -->
    <div id="mobile-admin-section" class="flex-col gap-1 hidden">
        <div class="px-2 mb-2 pt-4 border-t border-gray-100 dark:border-gray-800">
          <span class="text-xs font-semibold text-red-500/80 uppercase tracking-wider">
            Administración
          </span>
        </div>
        <ul class="space-y-1" role="list">
          <li>
            <a href="/dashboard/admin/payments" class="flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-red-50 dark:hover:bg-red-900/10 hover:text-red-600 transition-colors" data-mobile-nav-link>
               <Icon name="lucide:dollar-sign" class="w-5 h-5 shrink-0" />
               <span>Pagos</span>
            </a>
          </li>
          <li>
            <a href="/dashboard/admin/destinations" class="flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-red-50 dark:hover:bg-red-900/10 hover:text-red-600 transition-colors" data-mobile-nav-link>
               <Icon name="lucide:map" class="w-5 h-5 shrink-0" />
               <span>Destinos</span>
            </a>
          </li>
          <li>
            <a href="/dashboard/admin/promote" class="flex items-center gap-3 px-3 py-3 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-red-50 dark:hover:bg-red-900/10 hover:text-red-600 transition-colors" data-mobile-nav-link>
               <Icon name="lucide:shield-check" class="w-5 h-5 shrink-0" />
               <span>Promover</span>
            </a>
          </li>
        </ul>
    </div>
  </nav>

  <!-- Footer Actions (Logout) -->
  <div class="p-4 border-t border-gray-200 dark:border-gray-800  shrink-0">
    <button
        id="mobile-logout-btn"
        class="flex items-center justify-center gap-3 w-full px-4 py-3 rounded-lg border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 text-sm font-medium hover:bg-red-50 hover:text-red-600 hover:border-red-200 dark:hover:bg-red-900/20 dark:hover:text-red-400 dark:hover:border-red-900 transition-all"
        aria-label="Cerrar sesión"
        onclick="handleLogoutMobile()"
      >
        <Icon name="lucide:log-out" class="w-5 h-5 shrink-0" />
        <span>Cerrar sesión</span>
      </button>
  </div>
</aside>

<script>
  // Función de logout específica para mobile (o global si prefieres reutilizar)
  window.handleLogoutMobile = async function() {
    const sessionToken = document.cookie.match(/session_token=([^;]+)/)?.[1];
    
    try {
      if (sessionToken) {
        await fetch('http://localhost:8000/auth/logout/', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${sessionToken}`
          }
        });
      }
    } catch (error) {
      console.error('Logout error:', error);
    } finally {
      document.cookie = 'session_token=; path=/; max-age=0; secure; samesite=strict';
      localStorage.removeItem('pending_search');
      localStorage.removeItem('user_session');
      window.location.href = '/';
    }
  };

  function initMobileNav() {
    const mobileNav = document.getElementById('mobile-nav');
    const backdrop = document.getElementById('mobile-nav-backdrop');
    const closeBtn = document.getElementById('mobile-nav-close');

    if (!mobileNav || !backdrop || !closeBtn) return;

    // --- Funciones de control ---

    function openMobileNav() {
      // Mostrar backdrop
      backdrop?.classList.remove('hidden');
      // Timeout pequeño para permitir que la clase opacity surta efecto (fade in)
      setTimeout(() => {
        backdrop?.classList.remove('opacity-0', 'pointer-events-none');
      }, 10);

      // Deslizar menú (Quitar translate negativo)
      mobileNav?.classList.remove('-translate-x-full');
      
      // Bloquear scroll del body
      document.body.style.overflow = 'hidden';

      // Foco en cerrar
      closeBtn?.focus();
    }

    function closeMobileNav() {
      // Ocultar menú (Volver a translate negativo)
      mobileNav?.classList.add('-translate-x-full');

      // Ocultar backdrop (fade out)
      backdrop?.classList.add('opacity-0', 'pointer-events-none');
      
      // Esperar a la transición para poner hidden
      setTimeout(() => {
        backdrop?.classList.add('hidden');
      }, 300);

      // Restaurar scroll
      document.body.style.overflow = '';
    }

    // --- Event Listeners ---

    // Escuchar evento personalizado (disparado por el botón hamburguesa del header o sidebar)
    // NOTA: El botón flotante del sidebar ahora debería disparar este evento.
    document.addEventListener('open-mobile-nav', openMobileNav);
    
    // También escuchar el click en el botón flotante del otro componente si dispara evento
    const mobileTrigger = document.getElementById('mobile-menu-trigger');
    if(mobileTrigger) {
        mobileTrigger.addEventListener('click', openMobileNav);
    }

    closeBtn.addEventListener('click', closeMobileNav);
    backdrop.addEventListener('click', closeMobileNav);

    // Cerrar al hacer click en un link
    const navLinks = mobileNav.querySelectorAll('[data-mobile-nav-link]');
    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        setTimeout(closeMobileNav, 150);
      });
    });

    // Cerrar con ESC
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileNav.classList.contains('-translate-x-full')) {
        closeMobileNav();
      }
    });
    
    // --- Lógica Admin ---
    const storedUser = localStorage.getItem('authUser');
    if (storedUser) {
        try {
            const user = JSON.parse(storedUser);
            if (user.is_staff || user.is_superuser) {
                const adminSection = document.getElementById('mobile-admin-section');
                if (adminSection) {
                    adminSection.classList.remove('hidden');
                    adminSection.classList.add('flex');
                }
            }
        } catch(e) {
            console.error("Error checking admin status", e);
        }
    }

    // Limpieza al cambiar de página (Astro View Transitions)
    document.addEventListener('astro:before-preparation', closeMobileNav);
  }

  // Inicialización
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileNav);
  } else {
    initMobileNav();
  }
  document.addEventListener('astro:page-load', initMobileNav);
</script>

<style>
  /* 
    Estilos para scrollbar (se mantienen igual que en desktop para consistencia)
  */
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: #d1d5db; /* gray-300 */
    border-radius: 9999px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background-color: #9ca3af; /* gray-400 */
  }
  
  :global(.dark) .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: #4b5563; /* gray-600 */
  }
  :global(.dark) .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background-color: #6b7280; /* gray-500 */
  }
</style>