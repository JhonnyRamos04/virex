---
/**
 * Sidebar Desktop - Componente de navegación lateral exclusivo para escritorio
 */

import { Icon } from 'astro-icon/components';
import { dashboardNavigation } from '../../config/dashboard-navigation';

// Obtener ruta actual
const currentPath = Astro.url.pathname;

/**
 * Función auxiliar para verificar si un ítem está activo
 */
function isActive(href: string, children?: any[]): boolean {
  if (currentPath === href) return true;
  if (children) {
    return children.some((child) => currentPath === child.href);
  }
  return false;
}
---

<aside 
  id="dashboard-sidebar" 
  class="hidden md:flex flex-col fixed top-0 left-0 h-full bg-zinc-50 dark:bg-zinc-950 border-r border-zinc-200 dark:border-zinc-800 z-30 transition-all duration-300 ease-in-out w-64 in-[.sidebar-collapsed]:w-20"
  aria-label="Navegación de escritorio"
>
  
  <!-- Header / Logo -->
  <div class="h-16 px-4 flex items-center border-b border-zinc-200 dark:border-zinc-800 shrink-0 in-[.sidebar-collapsed]:justify-center transition-all">
    <a href="/dashboard" class="flex items-center gap-3 text-zinc-900 dark:text-white font-semibold text-lg hover:opacity-80 transition-opacity">
      <Icon name="lucide:layout-dashboard" class="w-6 h-6 text-zinc-900 dark:text-white shrink-0" />
      <span class="whitespace-nowrap transition-all duration-300 in-[.sidebar-collapsed]:w-0 in-[.sidebar-collapsed]:opacity-0 in-[.sidebar-collapsed]:overflow-hidden">
        GoFlowTrips
      </span>
    </a>
  </div>

  <!-- Navegación Principal (Scrollable) -->
  <nav class="flex-1 overflow-y-auto overflow-x-hidden py-4 px-3 space-y-6 custom-scrollbar">
    {
      dashboardNavigation.map((section) => (
        <div class="flex flex-col gap-1">
          {/* Título de Sección */}
          {section.title && (
            <div class="px-2 mb-2 in-[.sidebar-collapsed]:hidden">
              <span class="text-xs font-semibold text-zinc-400 dark:text-zinc-500 uppercase tracking-wider">
                {section.title}
              </span>
            </div>
          )}

          {/* Items */}
          <ul class="space-y-1" role="list">
            {section.items.map((item) => {
              const itemActive = isActive(item.href, item.children);

              return (
                <li>
                  <a
                    href={item.href}
                    class:list={[
                      'group flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-200 relative',
                      itemActive 
                        ? 'bg-zinc-200/50 dark:bg-zinc-800 text-zinc-900 dark:text-white shadow-none' 
                        : 'text-zinc-600 dark:text-zinc-300 hover:bg-zinc-200/30 dark:hover:bg-zinc-900/50 hover:text-zinc-900 dark:hover:text-white'
                    ]}
                  >
                    <Icon name={`lucide:${item.icon}`} class="w-5 h-5 shrink-0" />
                    
                    <span class="flex-1 whitespace-nowrap transition-all duration-300 in-[.sidebar-collapsed]:w-0 in-[.sidebar-collapsed]:opacity-0 in-[.sidebar-collapsed]:overflow-hidden">
                      {item.label}
                    </span>

                    {item.children && (
                      <Icon
                        name="lucide:chevron-down"
                        class:list={[
                          'w-4 h-4 shrink-0 transition-transform duration-200 in-[.sidebar-collapsed]:hidden',
                          { 'rotate-180': itemActive }
                        ]}
                      />
                    )}
                    
                    {/* Tooltip flotante (Solo visible cuando está colapsado) */}
                    <span class="absolute left-full ml-2 px-2 py-1 bg-gray-900 text-white text-xs rounded opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity z-50 whitespace-nowrap hidden in-[.sidebar-collapsed]:block shadow-lg">
                      {item.label}
                    </span>
                  </a>

                  {/* Submenú (Children) */}
                  {item.children && (
                    <ul
                      class:list={[
                        'mt-1 space-y-1 overflow-hidden transition-all duration-300 in-[.sidebar-collapsed]:hidden',
                        itemActive ? 'max-h-96 opacity-100' : 'max-h-0 opacity-0'
                      ]}
                    >
                      {item.children.map((child) => (
                        <li>
                          <a
                            href={child.href}
                            class:list={[
                              'flex items-center gap-3 pl-11 pr-3 py-2 rounded-lg text-sm transition-colors',
                              currentPath === child.href
                                ? 'text-zinc-900 dark:text-white bg-zinc-200/50 dark:bg-zinc-800/50 font-medium'
                                : 'text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white hover:bg-zinc-200/30 dark:hover:bg-zinc-900/50'
                            ]}
                          >
                            <Icon name={`lucide:${child.icon}`} class="w-4 h-4" />
                            <span class="truncate">{child.label}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }

    <!-- Admin Navigation (Oculto por defecto, activado por JS) -->
    <div id="admin-nav-section" class="flex-col gap-1 hidden">
      <div class="px-2 mb-2 in-[.sidebar-collapsed]:hidden">
        <span class="text-xs font-semibold text-red-500/80 uppercase tracking-wider">
          Administración
        </span>
      </div>
      <ul class="space-y-1" role="list">
        <li>
          <a href="/dashboard/admin/payments" class="group flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-zinc-700 dark:text-zinc-300 hover:bg-red-50 dark:hover:bg-red-900/10 hover:text-red-600 transition-all relative">
             <Icon name="lucide:dollar-sign" class="w-5 h-5 shrink-0" />
             <span class="whitespace-nowrap transition-all duration-300 in-[.sidebar-collapsed]:w-0 in-[.sidebar-collapsed]:opacity-0 in-[.sidebar-collapsed]:overflow-hidden">Pagos</span>
             {/* Tooltip Admin */}
             <span class="absolute left-full ml-2 px-2 py-1 bg-gray-900 text-white text-xs rounded opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity z-50 whitespace-nowrap hidden in-[.sidebar-collapsed]:block shadow-lg">
                Pagos
             </span>
          </a>
        </li>
        <li>
          <a href="/dashboard/admin/destinations" class="group flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-red-50 dark:hover:bg-red-900/10 hover:text-red-600 transition-all relative">
             <Icon name="lucide:map" class="w-5 h-5 shrink-0" />
             <span class="whitespace-nowrap transition-all duration-300 in-[.sidebar-collapsed]:w-0 in-[.sidebar-collapsed]:opacity-0 in-[.sidebar-collapsed]:overflow-hidden">Destinos</span>
             <span class="absolute left-full ml-2 px-2 py-1 bg-gray-900 text-white text-xs rounded opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity z-50 whitespace-nowrap hidden in-[.sidebar-collapsed]:block shadow-lg">
                Destinos
             </span>
          </a>
        </li>
        <li>
          <a href="/dashboard/admin/promote" class="group flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-red-50 dark:hover:bg-red-900/10 hover:text-red-600 transition-all relative">
             <Icon name="lucide:shield-check" class="w-5 h-5 shrink-0" />
             <span class="whitespace-nowrap transition-all duration-300 in-[.sidebar-collapsed]:w-0 in-[.sidebar-collapsed]:opacity-0 in-[.sidebar-collapsed]:overflow-hidden">Promover</span>
             <span class="absolute left-full ml-2 px-2 py-1 bg-gray-900 text-white text-xs rounded opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity z-50 whitespace-nowrap hidden in-[.sidebar-collapsed]:block shadow-lg">
                Promover
             </span>
          </a>
        </li>
      </ul>
    </div>
  </nav>

  <!-- Footer / Acciones de Usuario -->
  <div class="p-4 border-t  border-gray-200 dark:border-gray-800 space-y-2  shrink-0">
    
    <!-- Botón Logout -->
    <button
      id="logout-btn"
      class="flex items-center gap-3 w-full px-3 py-2.5 rounded-lg border border-zinc-200 dark:border-zinc-700 text-zinc-600 dark:text-zinc-400 text-sm font-medium hover:bg-red-50 hover:text-red-600 hover:border-red-200 dark:hover:bg-red-900/20 dark:hover:text-red-400 dark:hover:border-red-900 transition-all group in-[.sidebar-collapsed]:justify-center relative"
      aria-label="Cerrar sesión"
      onclick="handleLogout()"
    >
      <Icon name="lucide:log-out" class="w-5 h-5 shrink-0 group-hover:scale-110 transition-transform" />
      <span class="whitespace-nowrap transition-all duration-300 in-[.sidebar-collapsed]:w-0 in-[.sidebar-collapsed]:opacity-0 in-[.sidebar-collapsed]:overflow-hidden">Cerrar sesión</span>
      
      {/* Tooltip Logout */}
      <span class="absolute left-full ml-2 px-2 py-1 bg-red-600 text-white text-xs rounded opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity z-50 whitespace-nowrap hidden in-[.sidebar-collapsed]:block shadow-lg">
         Cerrar sesión
      </span>
    </button>

    <!-- Botón Colapsar Sidebar -->
    <button
      id="sidebar-toggle"
      class="flex items-center gap-3 w-full px-3 py-2.5 rounded-lg text-zinc-500 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-sm font-medium transition-colors in-[.sidebar-collapsed]:justify-center"
      aria-label="Contraer barra lateral"
    >
      <Icon name="lucide:chevrons-left" class="w-5 h-5 shrink-0 in-[.sidebar-collapsed]:hidden" />
      <Icon name="lucide:chevrons-right" class="w-5 h-5 shrink-0 hidden in-[.sidebar-collapsed]:block" />
      <span class="whitespace-nowrap transition-all duration-300 in-[.sidebar-collapsed]:w-0 in-[.sidebar-collapsed]:opacity-0 in-[.sidebar-collapsed]:overflow-hidden">Contraer</span>
    </button>
  </div>
</aside>

<script>
  // --- Lógica de Logout Global ---
  window.handleLogout = async function() {
    const sessionToken = document.cookie.match(/session_token=([^;]+)/)?.[1];
    
    try {
      if (sessionToken) {
        await fetch('http://localhost:8000/auth/logout/', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${sessionToken}`
          }
        });
      }
    } catch (error) {
      console.error('Logout error:', error);
    } finally {
      document.cookie = 'session_token=; path=/; max-age=0; secure; samesite=strict';
      localStorage.removeItem('pending_search');
      localStorage.removeItem('user_session');
      window.location.href = '/';
    }
  };

  function initDesktopSidebar() {
    const toggleBtn = document.getElementById('sidebar-toggle');
    const html = document.documentElement;

    // 1. Manejo del Estado Colapsado
    const isCollapsed = localStorage.getItem('dashboard-sidebar-collapsed') === 'true';
    
    if (isCollapsed) {
      html.classList.add('sidebar-collapsed');
    } else {
      html.classList.remove('sidebar-collapsed');
    }

    if (toggleBtn) {
      // Remover listeners anteriores para evitar duplicados en navegaciones SPA
      const newBtn = toggleBtn.cloneNode(true);
      toggleBtn.parentNode?.replaceChild(newBtn, toggleBtn);
      
      newBtn.addEventListener('click', () => {
        const currentlyCollapsed = html.classList.contains('sidebar-collapsed');
        const newCollapsed = !currentlyCollapsed;

        if (newCollapsed) {
          html.classList.add('sidebar-collapsed');
        } else {
          html.classList.remove('sidebar-collapsed');
        }

        localStorage.setItem('dashboard-sidebar-collapsed', String(newCollapsed));
        
        // Dispara evento para que el Layout principal ajuste el margen del contenido
        document.dispatchEvent(new CustomEvent('sidebar-toggle', { detail: { collapsed: newCollapsed } }));
      });
    }

    // 2. Manejo de Permisos de Administrador
    const storedUser = localStorage.getItem('authUser');
    if (storedUser) {
        try {
            const user = JSON.parse(storedUser);
            if (user.is_staff || user.is_superuser) {
                const adminSection = document.getElementById('admin-nav-section');
                if (adminSection) {
                    adminSection.classList.remove('hidden');
                    adminSection.classList.add('flex');
                }
            }
        } catch(e) {
            console.error("Error al verificar estado admin", e);
        }
    }
  }

  // Inicialización (Soporte para carga inicial y View Transitions de Astro)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDesktopSidebar);
  } else {
    initDesktopSidebar();
  }
  document.addEventListener('astro:page-load', initDesktopSidebar);
</script>

<style>
  /* 
    Scrollbar personalizado ligero 
    Colores hardcoded para evitar problemas con @apply en bloques style
  */
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  
  /* Light mode thumb */
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: #d1d5db; /* gray-300 */
    border-radius: 9999px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background-color: #9ca3af; /* gray-400 */
  }

  /* Dark mode thumb */
  :global(.dark) .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: #4b5563; /* gray-600 */
  }
  :global(.dark) .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background-color: #6b7280; /* gray-500 */
  }
</style>