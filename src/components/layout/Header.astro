---
import ThemeToggle from '@ui/ThemeToggle.astro';
import { Icon } from 'astro-icon/components';
---

<header
  id="site-header"
  class="sticky top-0 z-50 p-1.5 bg-background/80 backdrop-blur-md border-b border-surface"
>
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" aria-label="Main navigation">
    <div class="flex items-center justify-between h-16">
      <!-- Logo / Site Name -->
      <a href="/" class="flex items-center gap-2 group">
        <Icon 
          name="lucide:plane" 
          class="w-6 h-6 text-primary dark:text-primary transform rotate-45 group-hover:scale-110 transition-transform duration-300" 
        />
        <span class="text-xl font-bold text-black dark:text-primary group-hover:text-primary dark:group-hover:text-primary transition-colors duration-300">
          GoFlowTrip
        </span>
      </a>

      <!-- Desktop Actions - Right -->
      <div class="hidden md:flex items-center gap-4">
        <ThemeToggle />
        <a
          href="/login"
          class="px-4 py-2 rounded-md bg-primary text-white text-sm font-medium hover:bg-primary-dark transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          Iniciar Sesión
        </a>
      </div>

      <!-- Mobile menu button -->
      <div class="flex items-center gap-2 md:hidden">
        <ThemeToggle />
        <a
          href="/login"
          class="px-3 py-2 rounded-md bg-primary text-white text-sm font-medium hover:bg-primary-dark transition-colors duration-200"
        >
          Iniciar Sesión
        </a>
      </div>
    </div>
  </nav>
</header>
