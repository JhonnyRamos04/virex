---
/**
 * Footer - Minimalist
 */
import { siteConfig } from '@/config';
import { Icon } from 'astro-icon/components';

const { navigation } = siteConfig;
const { footer } = navigation;
const currentYear = new Date().getFullYear();

// Usamos solo los links legales para este diseño minimalista
const legalLinks = footer.legal || [];
---

<footer class="bg-white dark:bg-surface pt-20 pb-10">
  <div class="max-w-7xl mx-auto px-6">
    
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-6 border-b border-gray-100 dark:border-gray-800">
      
      <!-- Brand Simplificado -->
      <a href="/" class="group flex items-center gap-2 text-black dark:text-white transition-opacity hover:opacity-70">
        <div class="bg-gray-100 dark:bg-gray-800 p-1.5 rounded-lg group-hover:bg-primary/50 dark:group-hover:bg-primary/30 transition-colors">
          <Icon name="lucide:plane" class="w-5 h-5 text-primary dark:text-primary transform rotate-45" />
        </div>
        <span class="font-medium tracking-tight text-lg">GoFlowTrip</span>
      </a>

      <!-- Navegación Legal -->
      <nav class="flex flex-wrap justify-center gap-x-8 gap-y-2">
        {legalLinks.map((link) => (
          <a 
            href={link.href} 
            class="text-sm text-gray-800 hover:text-black dark:text-gray-400 dark:hover:text-white transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <!-- Copyright Discreto -->
    <div class="mt-6 text-center md:text-left flex flex-col md:flex-row justify-between items-center text-xs text-gray-900 dark:text-gray-400">
      <p>&copy; {currentYear} Todos los derechos reservados.</p>
      
      <!-- Redes Sociales (Opcional - Placeholder minimalista) -->
      <div class="flex gap-4 mt-4 md:mt-0">
        <a href="#" class="hover:text-gray-600 transition-colors">Instagram</a>
        <a href="#" class="hover:text-gray-600 transition-colors">Twitter</a>
      </div>
    </div>
  </div>
</footer>