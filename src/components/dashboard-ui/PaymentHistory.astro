---
import { Icon } from 'astro-icon/components';
import type { PaymentHistory } from '@/lib/travel-data';

interface Props {
  payments: PaymentHistory[];
}

const { payments } = Astro.props;

const getStatusColor = (status: string) => {
  switch (status) {
    case 'confirmed': return 'text-green-600 bg-green-50 border-green-200';
    case 'pending': return 'text-yellow-600 bg-yellow-50 border-yellow-200';
    case 'failed': return 'text-red-600 bg-red-50 border-red-200';
    default: return 'text-gray-600 bg-gray-50 border-gray-200';
  }
};

const getMethodIcon = (method: string) => {
  const m = method.toLowerCase();
  if (m.includes('zelle')) return 'simple-icons:zelle';
  if (m.includes('paypal')) return 'simple-icons:paypal';
  if (m.includes('movil') || m.includes('móvil')) return 'lucide:smartphone';
  return 'lucide:credit-card';
};
---

<div class="bg-surface rounded-xl shadow-sm border border-border overflow-hidden">
  <div class="p-6 border-b border-border">
    <h3 class="text-lg font-semibold text-text">Historial de Pagos</h3>
  </div>
  
  <div class="divide-y divide-border">
    {payments.length === 0 ? (
      <div class="p-8 text-center text-text-muted">
        No hay pagos registrados.
      </div>
    ) : (
      payments.map((payment) => (
        <div class="p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-surface-2 transition-colors">
          <div class="flex items-start gap-4">
            <div class={`p-2 rounded-full bg-surface border border-border shrink-0`}>
              <Icon name={getMethodIcon(payment.method)} class="w-6 h-6 text-text-muted" />
            </div>
            <div>
              <h4 class="font-medium text-text">{payment.description}</h4>
              <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-1 text-sm text-text-muted">
                <span class="flex items-center gap-1">
                  <Icon name="lucide:calendar" class="w-3.5 h-3.5" />
                  {payment.date.toLocaleDateString()}
                </span>
                <span class="flex items-center gap-1">
                  <Icon name="lucide:hash" class="w-3.5 h-3.5" />
                  {payment.reference}
                </span>
              </div>
            </div>
          </div>

          <div class="flex items-center justify-between sm:justify-end gap-4 w-full sm:w-auto">
            <span class={`px-2.5 py-0.5 rounded-full text-xs font-medium border ${getStatusColor(payment.status)} capitalize`}>
              {payment.status === 'confirmed' ? 'Confirmado' : payment.status === 'pending' ? 'Pendiente' : 'Fallido'}
            </span>
            <span class="text-lg font-bold text-text">
              ${payment.amount}
            </span>
          </div>
        </div>
      ))
    )}
  </div>
</div>
